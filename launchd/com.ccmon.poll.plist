<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The ccmon poll job, as launchd sees it: the counterpart of
  systemd/claude-usage.{service,timer}. Installed to
  ~/Library/LaunchAgents by ./ccmon, which is also the only place the setup is
  described.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ccmon.poll</string>

  <!--
    launchd expands nothing in a plist - not ~, not $HOME, and not in
    StandardOutPath either. Rendering a per-user copy would cost the byte
    comparison that makes ./ccmon idempotent, so the path is handed to bash
    instead, which launchd does give a HOME. One string then carries both the
    program and its log, which is why there is no StandardOutPath below.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "$HOME/.claude/ccmon/usage-poll.sh" &gt;&gt;"$HOME/.claude/ccmon/poll.log" 2&gt;&amp;1</string>
  </array>

  <!--
    OnStartupSec=30s and OnUnitActiveSec=5min, as the systemd timer has them. A
    run missed while the Mac was asleep fires once on wake, which is what
    Persistent=true bought over there.
  -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>

  <!--
    An agent inherits PATH=/usr/bin:/bin:/usr/sbin:/sbin, with no Homebrew in
    it. jq is the hard dependency: /usr/bin/jq from macOS 15.4 onward, a
    Homebrew prefix before that, and that prefix differs by architecture - so
    name both rather than guess which Mac this is.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
