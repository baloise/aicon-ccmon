{
  "title": "Claude usage (ccmon)",
  "uid": "ccmon-usage",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "account",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(claude_usage_seven_day_percent, account)",
        "refresh": 1,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "7-day window",
      "description": "Weekly quota across all models. Collapsed with max() because every machine reports the same account-wide number. Red marks 95%, the target ceiling: Grafana has no pace factor to colour by, so it only flags the one level that means trouble regardless of the clock.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "max(claude_usage_seven_day_percent{account=~\"$account\"})",
          "legendFormat": "all models",
          "refId": "A"
        },
        {
          "expr": "max by (scope) (claude_usage_scoped_percent{account=~\"$account\"})",
          "legendFormat": "{{scope}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 8, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "5-hour window",
      "description": "Session quota. Sawtooths as each 5-hour window resets. Red marks the 95% target ceiling; see the 7-day panel.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "max(claude_usage_five_hour_percent{account=~\"$account\"})",
          "legendFormat": "session",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 8, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Reporting machines",
      "description": "One line per host that is pushing. Gaps are normal: a laptop that is asleep, or whose Claude token has expired, stops reporting.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "max by (host) (claude_usage_stale{account=~\"$account\"})",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 20, "lineWidth": 1, "drawStyle": "line", "lineInterpolation": "stepAfter" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "live", "color": "#3987E5" }, "1": { "text": "stale", "color": "#8F8E86" } } }
          ]
        },
        "overrides": []
      }
    }
  ]
}
